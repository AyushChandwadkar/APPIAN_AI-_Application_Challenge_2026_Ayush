{
  "name": "knowledge-retrieval-backend",
  "version": "1.0.0",
  "description": "Intelligent Knowledge Retrieval System - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "ts-node src/database/migrations/run.ts",
    "migrate:reset": "ts-node src/database/migrations/reset.ts",
    "seed": "ts-node src/database/seeds/run.ts",
    "worker:ingestion": "ts-node src/workers/pdfIngestionWorker.ts",
    "worker:embeddings": "ts-node src/workers/embeddingWorker.ts",
    "worker:regulatory": "ts-node src/workers/regulatoryFeedWorker.ts",
    "ingest": "ts-node src/scripts/ingestDocument.ts",
    "ingest:batch": "ts-node src/scripts/batchIngest.ts",
    "setup:pinecone": "ts-node src/scripts/setupPinecone.ts",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t knowledge-retrieval-backend .",
    "docker:run": "docker run -p 3000:3000 knowledge-retrieval-backend"
  },
  "keywords": [
    "knowledge-retrieval",
    "ai",
    "vector-search",
    "semantic-search",
    "pinecone",
    "openai",
    "insurance",
    "claims"
  ],
  "author": "Your Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.5",
    "redis": "^4.6.11",
    "@pinecone-database/pinecone": "^1.1.2",
    "openai": "^4.20.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "typeorm": "^0.3.17",
    "reflect-metadata": "^0.1.13",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "marked": "^11.0.0",
    "cheerio": "^1.0.0-rc.12",
    "csv-parse": "^5.5.3",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "axios": "^1.6.2",
    "bull": "^4.12.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "@sentry/node": "^7.91.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/morgan": "^1.9.9",
    "@types/pg": "^8.10.9",
    "@types/pdf-parse": "^1.1.4",
    "@types/lodash": "^4.14.202",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "@types/jest": "^29.5.11",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "testMatch": ["**/*.test.ts"],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}